spring:
  application:
    name: oops
  task:
    scheduling:
      pool:
        size: 3
  autoconfigure:
    exclude: org.springframework.boot.autoconfigure.security.servlet.UserDetailsServiceAutoConfiguration
  datasource:
    # ----- Scenario A: docker-compose.yml (bundled mysql via compose network) -----
    url: jdbc:mysql://mysql:3306/oops?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8&useUnicode=true
    username: oops
    password: oops
    # ----- Scenario B: docker-compose.local.yml (external mysql on host) -----
    # url: jdbc:mysql://host.docker.internal:3306/oops?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8&useUnicode=true
    # username: <your_user>
    # password: <your_password>
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    database-platform: org.hibernate.dialect.MySQLDialect
    hibernate:
      ddl-auto: none
    show-sql: false
    open-in-view: false
  flyway:
    enabled: true
    baseline-on-migrate: true
    baseline-version: 1

oops:
  admin:
    password: admin123
  jwt:
    secret: oops-jwt-secret-key-please-change-in-production-must-be-at-least-32-chars
    expiration: 604800000
  crypto:
    secret-key: oops-crypto-secret-key-please-change-in-production
  ingress:
    cert-resolver: letsencrypt-prod
  pipeline:
    image:
      clone: alpine/git:v2.49.0
      zip: alpine/curl:8.17.0
      push: quay.io/buildah/stable:v1.43.1
      registry-mirrors:
        docker.io: docker.m.daocloud.io
      unzip-excludes:
        - .git/*
        - "*/.git/*"
        - node_modules/*
        - "*/node_modules/*"
        - __MACOSX
        - __MACOSX/*
        - "*/__MACOSX"
        - "*/__MACOSX/*"
        - .DS_Store
        - "*/.DS_Store"
  metrics:
    history:
      # Assumed scrape interval of the monitoring backend; decides the chart bucket width.
      interval-seconds: 30
      # Longest range the usage charts may request.
      max-range-hours: 24
      # Every cluster is expected to run a Prometheus-compatible backend at the same address, queried through
      # that environment's API server proxy (its token needs services/proxy). The defaults below are where
      # kube-prometheus-stack installs itself; VictoriaMetrics is usually monitoring/vmsingle:8428.
      # Blank the namespace to hide the usage charts entirely.
      backend:
        namespace: monitoring
        service-name: prometheus-operated
        port: 9090
    # Resource alerts. Off unless enabled is set to true here: alerting messages real people and queries a monitoring
    # backend that not every cluster runs, so it waits to be asked for.
    # One set of thresholds for the whole installation — there is nothing to configure per application. Once on, an
    # application is covered by having CPU/memory limits set for an environment; without a limit there is no
    # denominator for the percentage, so it is skipped.
    # Notifications go to the application's owner over the configured external channel (e.g. Feishu).
    alert:
      enabled: false
      # CPU and memory are not given the same threshold on purpose. Exceeding a memory limit is an OOMKill —
      # discrete and fatal — so it warns earlier. Exceeding a CPU limit is throttling: latency degrades but nothing
      # dies, so the bar is higher and the window longer.
      cpu:
        threshold-percent: 95
        sustained-minutes: 10
      memory:
        threshold-percent: 90
        sustained-minutes: 5
      # How long a still-firing alert stays quiet before it is repeated. The scan runs every minute, so without this
      # one sustained problem would send one message a minute.
      repeat-interval-minutes: 30
  pod-filesystem:
    max-download-size-bytes: 52428800
    max-upload-size-bytes: 52428800
    max-edit-size-bytes: 1048576
  feishu:
    enabled: false
    app-id: cli_xxx
    app-secret: xxx
    redirect-uri: http://localhost:3000/auth/feishu/callback
  ide:
    enabled: false
    https: false
    domain: ide.k8s.example.com
    image: codercom/code-server:4.112.0-39
    middlewares:
      - code-server-csp-fix
      - code-server-oss-redirect
  object-storage:
    enabled: false
    endpoint: https://s3.oss-cn-hangzhou.aliyuncs.com
    region: cn-hangzhou
    bucket: oops-build-sources
    access-key:
    secret-key:
    path-style-access: false
    key-prefix: build-sources
    asset-key-prefix: oops-assets
    asset-base-url:
    upload-url-expiration-seconds: 900
    download-url-expiration-seconds: 1800
    max-file-size-bytes: 524288000
  sandbox:
    images:
      - python:3.12-slim
      - node:20-slim
